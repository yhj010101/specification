function scrapping014(input, bankCdList, RESP_DATA){
	var result = {};
	result.RESP_DATA = [];
	
	var jexAjax = jexjs.plugin('ajax', 'scrp_p001_01_r002');
	jexAjax.setting({'suffix': '.jct'});
	jexAjax.setting('async', false);
	jexAjax.set("REGR_ID", input.USER_ID);
	jexAjax.execute(function (res) {
		res.REC.forEach(function(v) {
			
			//bank_cd 존재 유무
			const found = bankCdList.some(el => el.BANK_CD === v.BANK_CD);
			
			if(found){
				const SERVICE_NM = bankCdList.find(x => x.BANK_CD === v.BANK_CD).SERVICE_NM;
				
				RESP_DATA.find(x => x.SERVICE_NM === SERVICE_NM).CERT_YN = 'Y';
			}else{								
				//계좌
				if("ACCT" === v.CERT_TYPE){
					RESP_DATA.find(x => x.SERVICE_NM === 'ACCTNO').CERT_YN = 'Y';
				}
				//카드
				else if("CARD" === v.CERT_TYPE){
					RESP_DATA.find(x => x.SERVICE_NM === 'CARDNO').CERT_YN = 'Y';
				}						
				//SNS (SNS 종류(0:쇼핑, 1:배달, 2:예약, 3:여행, 4:PG
				else if("SNS" === v.CERT_TYPE){
					if(v.BANK_CD === "0"){
						RESP_DATA.find(x => x.SERVICE_NM === 'SHOPPING').CERT_YN = 'Y';
					}
					else if(v.BANK_CD === "1"){
						RESP_DATA.find(x => x.SERVICE_NM === 'DELIVERY').CERT_YN = 'Y';
					}
					else if(v.BANK_CD === "2"){
						RESP_DATA.find(x => x.SERVICE_NM === 'BOOKING').CERT_YN = 'Y';
					}
					else if(v.BANK_CD === "3"){
						RESP_DATA.find(x => x.SERVICE_NM === 'TRAVEL').CERT_YN = 'Y';
					}
					else if(v.BANK_CD === "4"){
						RESP_DATA.find(x => x.SERVICE_NM === 'PAYMENTGATEWAY').CERT_YN = 'Y';									
					}
					else if(v.BANK_CD === "5"){
						RESP_DATA.find(x => x.SERVICE_NM === 'SHOPPINGMBUYER').CERT_YN = 'Y';
					}
				
				}	
				
			}		
		
		});
	})
	
	result.RESP_DATA = RESP_DATA;
    result.RSLT_CD = '0000'
    result.RSLT_MSG = '정상처리되었습니다.'

    console.log(result);
	return JSON.stringify(result);
	
}

