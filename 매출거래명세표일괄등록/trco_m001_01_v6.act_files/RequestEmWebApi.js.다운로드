async function scrapping004(imsi, taskCd, callbackFn) {
	debugger
	const scrapResult = async (imsi) => await regScrapData(imsi, taskCd);
	console.log("스크래핑 input" + JSON.stringify(imsi));	
    //resp_data 값 필요 -> output 예정
    var result = {};
    var RESP_DATA = [];
    
	scrapResult(imsi)
	.then((res) => {
        console.log('최종 결과값 res', res);

		// sns는 기관별 배열로 응답
		if(taskCd == "snss") {
			res.forEach(function(agencyData){
				agencyData.forEach(function(data) {
					var resp_data = {};
		        	resp_data.ERRCODE = data.RSLT_CD;
		        	resp_data.ERRMSG =  data.RSLT_MSG;
		        	//42110000 내역없음
		        	if('0000' === data.RSLT_CD || '42110000' === data.RSLT_CD){
		        		resp_data.SUCCESS_YN = 'Y'
		        	}
		        	else{
		        		resp_data.SUCCESS_YN = 'N'
		        	}
		
					// 2023-11-29, RSLT_CD === 0000 일 때 Output ErrorCode !== 00000000 일 때 Output 객체 추가
					if(data.Output.ErrorCode !== '00000000') {
						resp_data.Output = data.Output;
					}
		
		        	RESP_DATA.push(resp_data);
				});
	        });
			
		} else {
			res.forEach(function(data){
	        	var resp_data = {};
	        	resp_data.ERRCODE = data.RSLT_CD;
	        	resp_data.ERRMSG =  data.RSLT_MSG;
	        	//42110000 내역없음
	        	if('0000' === data.RSLT_CD || '42110000' === data.RSLT_CD){
	        		resp_data.SUCCESS_YN = 'Y'
	        	}
	        	else{
	        		resp_data.SUCCESS_YN = 'N'
	        	}
	
				// 2023-11-29, RSLT_CD === 0000 일 때 Output ErrorCode !== 00000000 일 때 Output 객체 추가
				if(data.Output.ErrorCode !== '00000000') {
					resp_data.Output = data.Output;
				}
	
	        	RESP_DATA.push(resp_data);
	        })
		}
		
        result.RSLT_CD = '0000'
        result.RSLT_MSG = '정상처리되었습니다.'
        result.RESP_DATA = RESP_DATA;
        
        console.log("스크래핑 결과" + JSON.stringify(result));
        
        callbackFn(result);
	})
	.catch(err => {
        var resp_data = {};
        resp_data.ERRMSG =  err
        resp_data.SUCCESS_YN = 'N'

        RESP_DATA.push(resp_data);

        result.RSLT_CD = '9999'
        result.RSLT_MSG = '오류'
        result.RESP_DATA = RESP_DATA;
        
        console.log("스크래핑 결과실패" + JSON.stringify(result));
        
        callbackFn(result);
	})
	
	
}

