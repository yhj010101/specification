    String.prototype.replaceAll = function (str1, str2) {
        var temp_str = this;
        if (temp_str == null || temp_str == "undefined" || temp_str == "") {
            return "";
        } else {
            temp_str = temp_str.replace(/(^\s*)|(\s*$)/gi, "");
            temp_str = temp_str.replace(eval("/" + str1 + "/gi"), str2);
            return temp_str;
