     * `timeout` 만큼 함수 실행을 지연시킵니다.
     * 사용자 입력(자동완성, 검색)이 끝나고 함수 실행이 필요한 경우에 사용합니다.
     * @example
     * $('#input').on('keyup', common.app.debounce(function (evt) {
     *     // keyup 이벤트가 발생한지 500ms동안 추가요청이 없을때 함수가 실행됩니다.
     * }, 500));
     * @param func 실행함수
     * @param timeout 지연시간 (밀리초)
     */
    common.app.debounce = function debounce(func, timeout = 300) {
        let timer;
        return (...args) => {
            clearTimeout(timer);
            timer = setTimeout(() => {
                func.apply(this, args);
            }, timeout);
        };
    };

    /**
