                }
            },
            info : function(message) {
                if ( 2 < _getLevelNumber() ) {
                    appendLine(message);
                }
            },
            debug: function(message) {
                if ( 3 < _getLevelNumber() ) {
                    appendLine(message);
                }
            }
        };
    };

    if (jexjs.getParameter("jex_logger") !== "html") {
        jexjs.logger = new ConsoleLogger();
    } else {
        jexjs.logger = new HtmlLogger();
