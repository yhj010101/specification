/**
 * 배포 목록 추가
 * @param gridObj

 * @return
 */
function addWdstListFromDb(gridObj) {

	var checkedWdstList;		//그리드에서 체크된 
	var filteredWdstList = [];	//그리드에서 체크된 항목중 필요한 데이터만 추출
//	var wdstFileInfoList = [];  //실제 파일 경로
	var addedWdstListStr;		//세션에 추가된 배포 목록(String 형태)
	var addedWdstListObj;		//세션에 추가된 배포 목록(Object 형태) 배포목록 비교용
	
	//체크박스 선택된 리스트 꺼내기 
	checkedWdstList = gridObj.checked();
	//체크된 항목이 null 인지 체크
	if(isChecked(checkedWdstList)) return false;
	//alert("[TEST] 0::" + JSON.stringify(checkedWdstList));
	
	if(checkedWdstList){
		$.each(checkedWdstList, function(i,v)
		{
			if("CODE" == v.COM_TP)
			{
				filteredWdstList.push({COM_ID:"", COM_TP:v.COM_TP, PKG_NM:"", LCLAS_CD:v.LCLAS_CD, SCLAS_CD:v.SCLAS_CD });
			}
			else
			{
				filteredWdstList.push({COM_ID:v.COM_ID, COM_NM:v.COM_NM, COM_TP:v.COM_TP, PKG_NM:v.PKG_NM, LCLAS_CD:"", SCLAS_CD:"" });
			}
		});
	}
	
	if(0!=filteredWdstList.length)
	{
		var jexAjax = jex.createAjaxUtil("comm_get_svn_path");
	    jexAjax.set("REC", filteredWdstList);
	    jexAjax.execute(function(dat) {
	    	//alert(JSON.stringify(dat.REC1)); // AJAX실행 -- 결과를 grid에 담는다.
	    	if(0==dat.REC1.length)
	    	{
	    		jex.printInfo("WM0089");
	    	}else {
	    		//alert("[TEST] 10::" + JSON.stringify(dat.REC1));
	    		//세션에서 배포 목록 가져오기
	    		addedWdstListStr = jex.getOpener().jex.get("addedWdstListStr"); 
	    		//null 아닌 경우 Object로   변경
	    		if(addedWdstListStr){
	    			addedWdstListObj = jex.parse(addedWdstListStr);
	    		}
	    		//alert("[TEST] 1::" + JSON.stringify(addedWdstListObj));
	    		
	    		//배포 목록에 파일이 이미 추가된 경우 종료 메시지 보이고 종료.
	    		if(addedWdstListObj){
	    			if(isWdstFileExist(gridObj, dat.REC1, addedWdstListObj)) return false;
	    		}
	    		//세션의 배포 목록이 null이거나 중복된 항목이 없는경우
	    		//alert("[TEST] 2::" + JSON.stringify(addedWdstListObj));
	    		//배포목록 리스트에 추가
	    		if(!jex.confirm("WM0047")) return false;
	    		
	    		if(addedWdstListObj){
	    			$.each(dat.REC1, function(i,v){
	    				addedWdstListObj.push(v);
	    			});
	    		}else	addedWdstListObj = dat.REC1;
	    		//배포 목록 리스트를 세션에 추가
	    		//alert(JSON.stringify(addedWdstListObj));
	    		jex.getOpener().jex.set("addedWdstListStr",jex.toStr(addedWdstListObj));
	    		
	    		jex.printInfo("WM0048");
	    		gridObj.checkMgr.uncheckAll();
	    		//alert("[TEST] 3::" + JSON.stringify(jex.getOpener().jex.get("addedWdstListStr")));
	    	}
	    });
	}

    
}

/**
 * 배포 목록에 이미 추가 되었는지 확인
 * @param gridObj
 * @param checkedWdstList :그리드에 체크된 배포 목록
 * @param addedWdstList   :세션에 저장된 배포 목록
 **/
function isWdstFileExist(gridObj, checkedWdstList, addedWdstList){
	var isExist=false;
	$.each(checkedWdstList,function(i,v){
		$.each(addedWdstList, function(j,w){
			if(v.WDST_FILE_NM == w.WDST_FILE_NM &&v.WDST_FILE_PATH == w.WDST_FILE_PATH){
				jex.printError("WM0049");
				//중복 항목 체크 해제
				gridObj.checkMgr.uncheck(v);
				isExist=true;
				return false;
			}
		});//end of each
		if(isExist==true){
			return false;
		}
	});//end of each
	return isExist;
}

