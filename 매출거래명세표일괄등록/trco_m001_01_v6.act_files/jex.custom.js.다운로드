/**
 * 정렬방식 패딩 고정
 */
function updateDATTP(datarow, change, gridName) {
	if( "SRT_NM" in change || "PAD_VLU" in change ) {
		if( datarow.DAT_TP === "X" || datarow.DAT_TP === "9" ) {
			alert("데이터 타입이 기타가 아닌 경우에는 수정이 불가능합니다.");
			for (var i in change) {
				delete change[i];
			}
			window[gridName].editMgr.cancel();
			return false;
		}
	}
	
	if( "DAT_TP" in change ) {
		if( change.DAT_TP === "X" ) {
			change.SRT_NM = "LEFT";
			change.PAD_VLU = " ";
		}
		else if( change.DAT_TP === "9" ) {
			change.SRT_NM = "RIGHT";
			change.PAD_VLU = "0";
		}
		else if( change.DAT_TP === "9X" ) {
			change.SRT_NM = "RIGHT";
			change.PAD_VLU = " ";
		}
		else if( change.DAT_TP === "X9" ) {
			change.SRT_NM = "LEFT";
			change.PAD_VLU = "0";
		}
	}
	return true;
}

