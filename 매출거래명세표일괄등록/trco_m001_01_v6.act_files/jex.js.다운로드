 * @example {"COMMON_HEAD":{"ERROR":true,"MESSAGE":"","CODE":""}}
 */
jexjs.isJexError = function( dat ){
    if ( !jexjs.isNull( dat ) && !jexjs.isNull(dat.COMMON_HEAD) ) {
        if ( !jexjs.isNull(dat.COMMON_HEAD.ERROR) && dat.COMMON_HEAD.ERROR ){
            return true;
        }
    }
    return false;
};

/**
