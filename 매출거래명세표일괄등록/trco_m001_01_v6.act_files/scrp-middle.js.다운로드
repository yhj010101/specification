// 날짜 관련 함수 객체
const dateFuncObj = {
	/**
	 * 날짜 형식 포맷 함수
	 * @param {string} date
	 * @breif 년, 월, 일 형식 맞춤
	 * @returns {string} date
	 */
	setDateFormat: (date) => {
		const currDate = new Date();
		const year = date.getFullYear();
		const month = (date.getMonth() + 1).toString().padStart(2, '0');
		const day = date.getDate().toString().padStart(2, '0');

		const modDay =
			date <= currDate
				? day
				: currDate.getDate().toString().padStart(2, '0');

		return `${year}${month}${modDay}`;
	},
	/**
	 * 조회기간 내 해당하는 각 월의 01일부터 마지막 일 추출
	 * @param {string} REQUEST_DATE_S
	 * @param {string} REQUEST_DATE_E
	 * @breif 1. 제일 마지막 일자는 현재일자를 넘지 않음
	 * @brief 2. 예시 - 20230915~20231024 => [{itemStrDt: '20230901', itemEndDt: '20230930'}, {itemStrDt: '20231001', itemEndDt: '20231031'}]
	 * @returns {object} monthlyDates
	 */
	genEachMonthTerm: (REQUEST_DATE_S, REQUEST_DATE_E) => {
		const sDate = new Date(
			REQUEST_DATE_S.substring(0, 4),
			parseInt(REQUEST_DATE_S.substring(4, 6)) - 1,
			parseInt(REQUEST_DATE_S.substring(6, 8))
		);
		const eDate = new Date(
			REQUEST_DATE_E.substring(0, 4),
			parseInt(REQUEST_DATE_E.substring(4, 6)) - 1,
			parseInt(REQUEST_DATE_E.substring(6, 8))
		);
		const currDate = new Date();
		currDate.setHours(0, 0, 0, 0);
		const monthDates = [];

		while (sDate <= eDate && sDate <= currDate) {
			const firstDay = new Date(
				sDate.getFullYear(),
				sDate.getMonth(),
				sDate.getDate()
			);
			let lastDay;
			if (sDate.getMonth() === eDate.getMonth()) {
				lastDay = new Date(
					Math.min(eDate, new Date(sDate.getFullYear(), sDate.getMonth() + 1, 0))
				);
			} else {
				lastDay = new Date(sDate.getFullYear(), sDate.getMonth() + 1, 0);
			}
			const modFirstDay =
				sDate <= currDate ? dateFuncObj.setDateFormat(firstDay) : dateFuncObj.setDateFormat(sDate);

			const modLastDay =
				lastDay <= eDate
					? dateFuncObj.setDateFormat(lastDay)
					: eDate <= currDate
						? dateFuncObj.setDateFormat(eDate)
						: dateFuncObj.setDateFormat(currDate);

			const monthObject = {
				itemStrDt: modFirstDay,
				itemEndDt: modLastDay,
			};
			monthDates.push(monthObject);
			sDate.setMonth(sDate.getMonth() + 1, 1);
		}
		const lastObject = monthDates[monthDates.length - 1];
		lastObject.itemEndDt = REQUEST_DATE_E;
		return monthDates;
	},
	/**
	 * 조회기간 내 월단위 추출
	 * @param {string} REQUEST_DATE_S
	 * @param {string} REQUEST_DATE_E
	 * @breif 20230915~20231024 => ['202309', '202310'] 로 출력 / 홈택스 사용
	 * @returns
	 */
	calcDate2MonthTerm: (REQUEST_DATE_S, REQUEST_DATE_E) => {
		const resMonths = [];
		const sYear = parseInt(REQUEST_DATE_S.slice(0, 4), 10);
		const sMonth = parseInt(REQUEST_DATE_S.slice(4, 6), 10);
		const eYear = parseInt(REQUEST_DATE_E.slice(0, 4), 10);
		const eMonth = parseInt(REQUEST_DATE_E.slice(4, 6), 10);

		for (let year = sYear; year <= eYear; year++) {
			const mStart = year === sYear ? sMonth : 1;
			const mEnd = year === eYear ? eMonth : 12;
			for (let month = mStart; month <= mEnd; month++) {
				resMonths.push(`${year}${month.toString().padStart(2, '0')}`);
			}
		}
		return resMonths;
	},
	/**
	 * 조회기간 내 해당하는 각 월의 01일부터 마지막 일 추출
	 * @param {string} REQUEST_DATE_S
	 * @param {string} REQUEST_DATE_E
	 * @breif 1. 제일 마지막 일자는 현재일자를 넘지 않음
	 * @brief 2. 예시 - 20230915~20231024 => [{itemStrDt: '20230901', itemEndDt: '20230930'}, {itemStrDt: '20231001', itemEndDt: '20231031'}]
	 * @returns {object} monthDates
	 */
	genMonthTerm: (REQUEST_DATE_S, REQUEST_DATE_E) => {
		const sDate = new Date(
			REQUEST_DATE_S.substring(0, 4),
			parseInt(REQUEST_DATE_S.substring(4, 6)) - 1,
			1
		);
		const eDate = new Date(
			REQUEST_DATE_E.substring(0, 4),
			parseInt(REQUEST_DATE_E.substring(4, 6)),
			0
		);
		const monthDates = [];
		while (sDate <= eDate) {
			const fDay = new Date(sDate.getFullYear(), sDate.getMonth(), 1);
			const lDay = new Date(sDate.getFullYear(), sDate.getMonth() + 1, 0);
			const monthObj = {
				itemStrDt: dateFuncObj.setDateFormat(fDay),
				itemEndDt: dateFuncObj.setDateFormat(lDay),
			};
			monthDates.push(monthObj);
			sDate.setMonth(sDate.getMonth() + 1);
		}
		return monthDates;
	},
}

