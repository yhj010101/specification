/**
 * 은행 스크래핑 호출 함수
 * @breif coltDv 기본 값은 '2'이며, '1'(증빙 자료수집센터)인 경우에 해당 함수 및 스크래핑 결과 로직 내 분기처리
 * @param {object} reqData
 * @param {string} taskCd
 * @param {...string} args
 * @returns {promise} scrapResult
 */
async function getBankScrapData({ reqData, taskCd, coltDv, RQST_COMMON }) {
	/** 기타계좌 여부 확인 */
	const isExistOtherDv = reqData.some((obj) =>
		obj.CERT_SSM_TYPE === '2' || obj.CERT_SSM_TYPE === '3'
	);

	reqData = utilFuncObj.checkOneDimensionalList(reqData);

	// 유저 정보 할당
	let { DEC_DATA, USE_INTT_ID, PROD_CD, BIZ_NO, USER_ID } = await infoFuncObj.getUserData(taskCd, RQST_COMMON);

	// 원장 정보
	const SCMS_DATA = await infoFuncObj.getScmsData(taskCd, USE_INTT_ID, USER_ID, isExistOtherDv); // scmsData도 변경 필요

	// 기타계좌 여부에 따라 DEC_DATA 필터링
	DEC_DATA = DEC_DATA.filter((acct) => {
		const matchingBItem = SCMS_DATA.REC.find(
			(scmsData) =>
				scmsData.ACCT_NO === acct.ACCT_NO &&
				(isExistOtherDv ? acct.SUBCOMP_IDNO === '0000000000' : acct.SUBCOMP_IDNO !== '0000000000')
		);
		return matchingBItem !== undefined;
	});

	const bankScrapDvObj = { // 계좌 구분별 코드
		SCRAPACCT: '01',
		SCRAPSAVING: '02',
		SCRAPLOAN: '03',
		SCRAPEXCHANGE: '04',
		SCRAPINVEST: '67'
	};
	// ACCT_NO가 빈 값인 경우, 계좌구분과 스크래핑명을 매칭하여 조건에 맞는 계좌를 ACCT_NO 값으로 추가
	reqData.forEach((item) => {
		if (item.ACCT_LIST && Array.isArray(item.ACCT_LIST)) {
			item.ACCT_LIST = item.ACCT_LIST.map((acct) => {
				if (acct?.ACCT_NO === '') {
					const acctDvValue = Object.entries(bankScrapDvObj).filter(([key, value]) => item.SCRAP_NM.includes(key)).flat()[1]
					return DEC_DATA.filter((dataItem) => dataItem.ACCT_DV === acctDvValue).map((dataItem) => ({
						ACCT_NO: dataItem.ACCT_NO,
						ACCT_BAL_GB: dataItem.ACCT_BAL_GB
					}));
				} else {
					return { ACCT_NO: acct.ACCT_NO };
				}
			})
		}
	});
	console.log('변경된 reqData: ', reqData);

	// 조회일자 필요없는 job 리스트
	const noNeedDateJobList = [
		'SCRAPACCTBALANCE',
		'SCRAPSAVINGSBALANCE',
		'SCRAPLOANEDBALANCE',
		'SCRAPEXCHANGEBALANCE',
		'SCRAPINVESTMENTBALANCE',
	];

	/**
	 * 인증정보와 reqData를 비교하여 job과 acct_list 키를 가진 객체로 가공 -> 함수명 리네임 필요
	 * @param {*} obj1 reqData의 ele
	 * @param {*} obj2 dec_data
	 * @returns
	 */
	function restoreData(obj1, obj2) {
		const restoreArr = [];
		const groupingData = {};
		let newObj = null;
		[...obj1.ACCT_LIST].forEach((acct) => {
			[...obj2].forEach((dbItem) => {
				newObj = {};
				if (acct.ACCT_NO) {
					if (
						obj1.SCRAP_NM === 'SCRAPEXCHANGEBALANCE' ||
						obj1.SCRAP_NM === 'SCRAPEXCHANGEDEALING'
					) {
						if (
							acct.ACCT_NO === dbItem.ACCT_NO &&
							obj1.CURR_CD === dbItem.CURR_CD
						) {
							const key = `${dbItem.ACCT_NO}_${dbItem.CURR_CD}`;
							if (!groupingData[key]) { // 계좌번호, 통화코드 중복 아닌 요소들 그룹화
								groupingData[key] = [dbItem];
								newObj = {
									...dbItem,
