			const groupedObjects = new Map();

			function groupObjects(obj) {
				const key = `${obj.MODULE}_${obj.CERT_NM}_${obj.IB_TYPE}`;
				if (groupedObjects.has(key)) {
					groupedObjects.get(key).push(obj);
				} else {
					groupedObjects.set(key, [obj]);
				}
			}

			arr.acct_list.forEach((objArray) => {
				objArray.forEach((obj) => {
					groupObjects(obj);
				});
			});

			const resultArray = Array.from(groupedObjects.values());
			arr.acct_list = resultArray;
		});
	} else {
		resArr.forEach((arr) => {
			if (
				arr.job === 'SCRAPEXCHANGEBALANCE' ||
				arr.job === 'SCRAPEXCHANGEDEALING'
			) {
				const groupedObjects = new Map();

				function groupObjects(obj) {
					const key = `${obj.MODULE}_${obj.CERT_NM}_${obj.IB_TYPE}`;
					if (groupedObjects.has(key)) {
						groupedObjects.get(key).push(obj);
					} else {
						groupedObjects.set(key, [obj]);
					}
				}

				arr.acct_list.forEach((objArray) => {
					objArray.forEach((obj) => {
						groupObjects(obj);
					});
				});

				const resultArray = Array.from(groupedObjects.values());
				arr.acct_list = resultArray;
			}
		});
	}

	function checkDuplData(data) {
		data.forEach((item) => {
			if (
				item.job === 'SCRAPEXCHANGEBALANCE' ||
				item.job === 'SCRAPEXCHANGEDEALING'
			) {
				item.acct_list = item.acct_list.map((subArray) => {
					let unique = new Map(
						subArray.map((obj) => [`${obj.ACCT_NO}-${obj.CURR_CD}`, obj])
					);
					return Array.from(unique.values());
				});
			}
		});
		return data;
	}
	resArr = checkDuplData(resArr);
	console.log('중복체크 resArr: ', resArr);
	if (resArr.length === 0) {
