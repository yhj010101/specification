// 일반 공통 유틸 함수 객체
const utilFuncObj = {
	/**
	 * reqData의 인증정보 LIST가 2차원 배열인 경우, 1차원 배열로 변환 / 
	 * 240605 - 함수명 checkReqData => checkOneDimensionalList
	 * @param {object} reqData
	 * @returns {object} reqData
	   */
	checkOneDimensionalList: (dataObj) => {
		const listName = Object.keys(dataObj[0]).find(data => data.endsWith('_LIST'));
		if (listName) {
			return dataObj.map((item) => {
				if (Array.isArray(item[listName][0])) {
					item[listName] = item[listName].flat();
				}
				return item;
			});
		} else {
			return dataObj;
		}
	},
	/**
   * reqData의 인증정보 LIST가 2차원 배열인 경우, 1차원 배열로 변환 / 
   * 240605 - 함수명 checkReqData => checkOneDimensionalList
   * @param {object} reqData
   * @returns {object} reqData
	 */
	fetchData: async (item) => {
		return new Promise((res, rej) => {
			let rtn = null;
			const xhr = new XMLHttpRequest();
			xhr.open('POST', `/gw/ScrGateWay`, true);
			xhr.setRequestHeader('Content-Type', 'application/json');
			xhr.setRequestHeader('X-HTTP-Method-Override', 'POST');
			xhr.onload = function() {
				if (xhr.status === 200) {
					const responseData = xhr.responseText;
					const s1 = `${responseData}`.trim();
					try {
						res(JSON.parse(s1));
					} catch {
						res(s1);
					}
				} else {
					throw new Error('decrypt 에러 발생');
				}
			};
			xhr.onerror = function(error) {
				alert('decode 에러 발생');
				rtn = error;
			};
			xhr.send(JSON.stringify(item));
		})
	}
};

/**
 * BC카드 신사이트 로그인용 사업자번호 보정
 * 지정 사업장은 BC카드에 등록된 사업자번호(2148635102)로 치환한다.
 * @param {string} bizNo 세션 사업자번호
 * @returns {string} 치환 대상이면 2148635102, 아니면 원본 bizNo
 */
function getBccardLoginBizNo(bizNo) {
	var BCCARD_BIZ_NO_REPLACE_TARGETS = ['1078527739', '9999999991', '1000000102', '7458101659'];
	var BCCARD_REGISTERED_BIZ_NO = '2148635102';
	var normalized = String(bizNo == null ? '' : bizNo).replace(/-/g, '');
	return BCCARD_BIZ_NO_REPLACE_TARGETS.indexOf(normalized) > -1 ? BCCARD_REGISTERED_BIZ_NO : bizNo;
}

