/**
 * 복호화 함수 (테스트 필요)
 * -- script 추가 방식 (scrp_0001_01 view 참조) --
 * head script 추가 시, 무조건 crypto -> scrp-util -> 사용할 페이지의 js 파일 순으로 추가
 * /js/jex/serp_cms/scrp/cryptojs-4.1.1.min.js"
 * /js/jex/serp_cms/scrp/jsencrypt_2.3.1.min.js
 * /js/jex/serp_cms/scrp/scrp-util.js
 * /js/jex/serp_cms/scrp/scrp_0001_01.js (예시파일, 실제 적용 시에는 사용할 페이지.js)
 * @param {*} originData 
 * @param {String} USE_INTT_ID 
 * @return {String} DEC_DATA
*/

function getDecData (encData, USE_INTT_ID, PBK_KEY) {
	if(encData === '' || encData === null) {
		const errMsg = 'encData 에러 발생';
		alert(errMsg);
		throw new Error(errMsg);
	} else if(PBK_KEY === '' || PBK_KEY === null) {
		const errMsg = 'PBK_KEY 에러 발생';
		alert(errMsg);
		throw new Error(errMsg);
	}
	// 16바이트의 iv 생성
	const iv = getSha256WithHex(USE_INTT_ID).substring(0, 32);
	// base64 인코딩 된 값 바이트 배열로 전환
  const BASE64_PBK_KEY = CryptoJS.enc.Base64.parse(PBK_KEY);
  
  // 암호화된 data를 AES 복호화
  const decrypted = CryptoJS.AES.decrypt(
	    encData,
	    BASE64_PBK_KEY,
	    {
	      iv: CryptoJS.enc.Hex.parse(iv),
	      mode: CryptoJS.mode.CBC,
	      padding: CryptoJS.pad.Pkcs7,
	    }
	  );

		// 복호화된 값을 UTF-8 문자열 디코딩
    const DEC_DATA = decrypted.toString(CryptoJS.enc.Utf8);
    return DEC_DATA;
};

/**
 * 암호화 함수
 * -- script 추가 방식 (scrp_0001_01 view 참조) --
 * head script 추가 시, 무조건 crypto -> scrp-util -> 사용할 페이지의 js 파일 순으로 추가
 * /js/jex/serp_cms/scrp/cryptojs-4.1.1.min.js"
 * /js/jex/serp_cms/scrp/jsencrypt_2.3.1.min.js
 * /js/jex/serp_cms/scrp/scrp-util.js
 * /js/jex/serp_cms/scrp/scrp_0001_01.js (예시파일, 실제 적용 시에는 사용할 페이지.js)
 * @param {*} originData 
 * @param {String} USE_INTT_ID 
 * @return {String} ENC_DATA
*/
function getEncData (originData, USE_INTT_ID, PBK_KEY) {
	try{
		// 16바이트의 iv 생성
		const iv = getSha256WithHex(USE_INTT_ID).substring(0, 32);
		let data = null;
		// 데이터 문자열화
		typeof originData === 'object' ? data = JSON.stringify(originData) : data = originData;
		
		// data를 AES 암호화
	  const encrypted = CryptoJS.AES.encrypt(
	    data,
	    CryptoJS.enc.Utf8.parse(PBK_KEY),
	    {
	      iv: CryptoJS.enc.Hex.parse(iv),
	      mode: CryptoJS.mode.CBC,
	      padding: CryptoJS.pad.Pkcs7,
	    }
	  );
	  
	  // BASE64 인코딩 문자열
	  const ENC_DATA = encrypted.toString();
		return ENC_DATA;	
	} catch (e) {
		throw new Error(e);
	};
};

/**
 * SHA256 해싱 함수
 * @param {String} str 
 * @return {String} hexString
*/
function getSha256WithHex(str) {
  const hashedStr = CryptoJS.SHA256(str);
  const hash2hex = hashedStr.toString(CryptoJS.enc.Hex);
  return hash2hex;
};

