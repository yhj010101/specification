/**
 * 금액 숫자형식 변경 및 원 추가 함수
 * @param {String or Number} event
 * @return {String} money
*/
function setAmount (money) {
  let count = 0;
  let arr = [];
  const strMoney = money.toString();
  const balLength = strMoney.length;

  for (let i = balLength; i > 0; i--) {
    if (count !== 0 && count % 3 === 0) {
      arr.unshift(",");
    };
    arr.unshift(strMoney[i - 1]);
    count++;
  };
  return arr.join('').toString() + '원';
};

/**
 * 입력값 검증 함수
 * @param {EventTarget} event 
 * @param {String} regCon 
*/
function chkRegStr (event, regCon) {
	event.stopImmediatePropagation();
  let alertMsg = '';
 	const regStr = regCon.toString();
 	console.log('regStr', regStr);
  switch (regStr) {
    case `/[^a-zA-Z0-9]/g`:
      alertMsg = '영문자와 숫자만 입력해주십시오.';
      break;
    case `/[^a-zA-Z0-9@#$%&*?!]/g`:
      alertMsg = '영문자, 숫자, !@#$%&*? 외에는 입력할 수 없습니다.';
      break;
    case `/[^0-9]/g`:
      alertMsg = '숫자만 입력해주십시오.';
      break;
    default:
      alertMsg = '잘못된 입력입니다.';
  };
  const chkValue = event.target.value.replace(regCon, '');
  console.log('current chkValue: ', chkValue);
  if(event.target.value !== chkValue) {
    event.target.value = null;
    alert(alertMsg);
  };
};

/**
 * 한글 입력 체크
 * @param {EventTarget} event 
 * @param {String} regCon 
*/
function chkRegStr2 (event, regCon) {
  const chkValue = event.target.value.replace(regCon, '');
  if(event.target.value !== chkValue) {
    alert(`한글은 입력할 수 없습니다.`);
    event.target.value = '';
  };
};

