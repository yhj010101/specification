            });
        },

        makeExcelGridData: function (input) {
			if(input.title){
				input.COLNAME = input.title;
			};

            return {
                key: input.VIEW_ID,
                name: input.COLNAME,
                width: Number(input.SIZE.replace(/[^0-9]/gi, '')),
                colClass: '',
                excelFormat: (input.align === 'RIGHT' ? 'int' : 'string')
            }
        }
    }
}


