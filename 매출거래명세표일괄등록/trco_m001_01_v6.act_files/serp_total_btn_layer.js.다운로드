            && !_target.is($('.depth2'))
            && !_target.is($('.depth2 > span'))
            && !_target.is($('[name=btn_sub]'))
            && !_target.is($('[name=btn_sub] > a'))) {
            $('.ly_total').hide();
            //$('#layer_rptr').hide();
            $('.ly_depth2').hide();
            $('.ly_depth3').hide();
        }

