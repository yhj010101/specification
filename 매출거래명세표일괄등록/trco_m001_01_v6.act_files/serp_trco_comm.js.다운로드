function setKeyInputNumberOnly(event)
{
    event = getEvent(event);
    var keycode = getKeycode(event);
    var elem = getEventElement(event);

    if ( keycode < 48 || keycode > 57 )//숫자 키코드값
    {
        // enter, tab, backspace 방향키(앞,뒤)는 예외처리
        if(keycode == 0 || keycode == 8 || keycode == 9 || keycode == 45)
        {
            return true;
        }
        if(IS_IE){
            event.returnValue = false;
        }else{
            event.preventDefault();
        }
    }
}

function setKeyInputNumberOnlyExceptHyphen(event)
{
	event = getEvent(event);
	var keycode = getKeycode(event);
	var elem = getEventElement(event);

	if ( keycode < 48 || keycode > 57 )//숫자 키코드값
	{
		// enter, tab, backspace 방향키(앞,뒤)는 예외처리
		// 2024-02-07 '-':45 제외
		if(keycode == 0 || keycode == 8 || keycode == 9)
		{
			return true;
		}
		if(IS_IE){
			event.returnValue = false;
		}else{
			event.preventDefault();
		}
	}
}

//IE여부
var IS_IE = false;
if(navigator.appName == 'Microsoft Internet Explorer'){
    IS_IE = true;
}



/**
 * 이벤트객체 리턴
 * ex) getEvent(event);
 * @param event : 이벤트 객체
 * @return : 멀티브라우저용 evnet 객체
 */
function getEvent(event){
    event = IS_IE ? window.event : event;

    return event;
}
/**
 * keycode값 리턴
 * ex) getKeycode(event);
 * @param event : 이벤트 객체
 * @return : 멀티브라우저용 keycode값
 */
function getKeycode(event){
    var keycode = IS_IE ? event.keyCode : event.which;

    return keycode;
}


/**
 * 이벤트가 발생한 객체 리턴
 * ex) getEventElement(event);
 * @param event : 이벤트 객체
 * @return : 멀티브라우저용 이벤트가 발생한 객체
 */
function getEventElement(event){
    var elem = IS_IE ? event.srcElement : event.target;

    return elem;
}

