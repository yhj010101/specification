/**
 * 팝업 열기 팝업 호출시 데이터 처리가 많아 처음 로딩시 about blank가 뜬다
 * 이를 해결 하기 위해서 window.open에 url을 넣은 뒤에 form 서브밋을 한다.
 * 이는 IE에서 발생한다........하...겨우 찾았네 그리고 open 하는 jsp 에서는 out.flush 로 
 * 로딩전에 이미지를 먼저 보여 준다. 
 * @param formId
 * @param options sizeW : 팝업넓이, sizeH: 팝업높이, target: form타켓, action : 웹서비스ID
 * @return
 */
function open_popup1(formId, options){
	var	sizeW = parseInt(options.sizeW, 10);	
	var	sizeH = parseInt(options.sizeH, 10);
	var nLeft = screen.width/2 - sizeW/2 ;
	var nTop  = screen.height/2- sizeH/2 ;
	var actionURL = options.action;
	var act_url = "";
	if(actionURL.indexOf("fax") > -1 || actionURL.indexOf("mail") > -1 ){
		act_url = options.action;
		if(act_url.indexOf("?") > -1){
			act_url = act_url + "&t="+new Date().getTime();			
		}else{
			act_url = act_url + "?t="+new Date().getTime();
		}
	}else{
		act_url = ""; 
	}
	
	//듀얼모니터
	nLeft += window.screenLeft;
	nTop += window.screenTop;
	
	var option= ",toolbar=no,menubar=no,location=no,scrollbars=yes,status=no,resizable=no";
	var winObj= window.open(act_url, options.target, "left=" + nLeft + ",top=" +  nTop + ",width=" + sizeW + ",height=" + sizeH  + option );

    taxPopState = winObj;
	
	try{
		//winObj.blur(); 	//크롭에서 focus()만 호출할경우 작동하지 않아서 blur()를 먼저 호출한후 focus()호출하도록 수정함.
		//winObj.focus();	//팝업이 이미 열려있는경우 앞으로 나오도록 한다.
	} catch(e){}
	var frm = document.getElementById(formId);

	if(!!frm){
		frm.method = "post";
		frm.target = options.target;
		
		if(!!options.action){
			if(options.action.indexOf("?") > -1){
				frm.action = options.action + "&t="+new Date().getTime();
			}else{
				frm.action = options.action + "?t="+new Date().getTime();
			}
		}
		frm.submit();
	}
	frm.target = "";
}
