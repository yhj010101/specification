    if($listClassNm.hasHorizontalScrollBar() && $listClassNm.hasScrollBar()){ // 가로 & 세로
        $listClassNm.attr("style", "height:509px;min-width:100%;overflow-y:auto;overflow-x:auto;max-height:inherit");
