        case "2":  // 1개월
            setCalendarBetween(startId,endId,"m", -1);
            break;
        case "3":  // 3개월
            setCalendarBetween(startId,endId,"m", -3);
            break;
        case "4":  // 당월
            $("#"+startId).val(getDate("yyyy-mm-01"));
            $("#"+endId  ).val(getDate("yyyy-mm-dd"));
