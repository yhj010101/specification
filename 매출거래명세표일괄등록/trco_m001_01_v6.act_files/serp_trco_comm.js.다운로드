function rightMoveEventImg() {
	if(_eventIndex.maxIndex == 0) return;
			
	if(_eventIndex.maxIndex > _eventIndex.nowIndex){
		_setFoot.imgEvent.animate({scrollLeft : _setFoot.imgEvent.width() * ++_eventIndex.nowIndex}, 300);

	}else{
		var $temp = _setFoot.imgEvent.find('li').first().clone();
		_setFoot.ulEvent.append($temp);
		_setFoot.imgEvent.animate({scrollLeft : _setFoot.imgEvent.width() * ++_eventIndex.nowIndex}
							    , 300
							    , function(){
								    _setFoot.imgEvent.scrollLeft(0);
								    _eventIndex.nowIndex = 0;
								    $temp.remove();
							    });
	}
}
	
