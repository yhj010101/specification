/**
 * 페이징처리
 * @param  div_id		페이징 표시할 요소 id
 * @param  callback		페이징 표시 후 실행될 함수
 * @param  curPageNo	현재페이지 번호 
 * @param  totPage		전체페이지 번호 
 */
function serp_drawTablePaing( div_id, callback, curPageNo, totPage) {
	var page_size = 10; //표시할 페이지 수
	if(_searchList.getPagePerCnt() == "7"){
		page_size  = _searchList.getPagePerCnt();
	}
	var currentPage  = (curPageNo)?curPageNo:1;
	if(currentPage < 1) currentPage = 1;
	if(currentPage > totPage) currentPage = totPage;
	var currentBlock = Math.ceil(currentPage/page_size);
	var firstPage     = currentBlock*page_size-page_size+1;
	var lastPage      = currentBlock*page_size;
	//combo box
	var comboHtml = "";
	comboHtml += '<div class="combo_wrap">' 
	comboHtml += '<div class="combo_style" id="pagingPopBtn">';
	comboHtml += '<a href="#none" class="btn_style btn_combo_down"><span>'+_searchList.getPagePerCnt()+'</span></a>';	
	comboHtml += '<ul class="up" style="display: none;top:-93px;">';
	if(document.URL.indexOf("trgm_m002_03.act") > -1 || document.URL.indexOf("trco_m006_01.act") > -1 || document.URL.indexOf("trco_m003_01.act") > -1 || document.URL.indexOf('memb_m002_01.act') > -1 || document.URL.indexOf("memb_m001_03.act") > -1){
		//거래명세표일괄등록 이전등록내역팝업, 활동내역팝업, 거래처상세조회 활동내역
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">100</a></li>';
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">40</a></li>';
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">20</a></li>';
	}else{
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">500</a></li>';
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">100</a></li>';
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">50</a></li>';
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">20</a></li>';
	}
	
	if(document.URL.indexOf("trco_m006_01.act"|| document.URL.indexOf("memb_m001_03.act") > -1) > -1){
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">10</a></li>';
	}else if(callback.name == "trco_acvt_hstr" || document.URL.indexOf('memb_m002_01.act') > -1){
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">7</a></li>';
	}else if(document.URL.indexOf("trco_m001_01.act") > -1 || document.URL.indexOf("trgm_m002_01.act") > -1 || document.URL.indexOf("trgm_m003_01.act") > -1
			|| document.URL.indexOf("trgm_m004_01.act") > -1 || document.URL.indexOf("trgm_m005_01.act") > -1 || document.URL.indexOf("trgm_m006_01.act") > -1
			|| document.URL.indexOf("trco_m012_01.act") > -1){
		//거래처 조회, 매출/매입 거래명세표, 견적서, 수주서, 발주서는 20 부터 시작
		//20230714 거래처 대시보드 추가
	}/*else{
		comboHtml += '<li><a href="#none" name="pageCntCheckBox">12</a></li>';
	}*/
	comboHtml += '</ul>';
	comboHtml += '</div>';
	comboHtml += '</div>';
	comboHtml += '<div class="paging" id="'+div_id+'"></div>';
	comboHtml += '<div class="unit_wrap"><span class="txt_unit grp_cnt"></span></div>';
	
	if($(".paging_wrap").html() == ""){
		$(".paging_wrap").append(comboHtml);	
	}else{
		$("a.btn_combo_down span").html(_searchList.getPagePerCnt());
	}
	
	$("#"+div_id).children().remove();
	
	if(totPage > 0){
		var firstHtml   = '<a href="#none" class="btn_pag_cntr first" id="paging_first"><span class="blind">first</span></a>';
		var prevHtml 	= '<a href="#none" class="btn_pag_cntr prev" id="paging_pre"><span class="blind">previous</span></a>';
		var nextHtml	= '<a href="#none" class="btn_pag_cntr next on" id="paging_next"><span class="blind">next</span></a>';
		var lastHtml	= '<a href="#none" class="btn_pag_cntr last on" id="paging_last"><span class="blind">last</span></a>'
		var pageHtml    = '<span class="pag_num">';
		for(var i = firstPage; i <= lastPage && i <= totPage;  i++){
			if(currentPage == i){
				pageHtml += "<a class=\"on\">"+i+"</a>";
			}else{ 
				pageHtml += "<a>"+i+"</a>";				
			}
			if(i != lastPage && i != totPage){
				pageHtml += "&nbsp;";
			}
		} 	
		pageHtml += " </span>";
		
		$("#"+div_id).append(firstHtml);
		$("#"+div_id).append(prevHtml);
		$("#"+div_id).append(pageHtml);
		$("#"+div_id).append(nextHtml);
		$("#"+div_id).append(lastHtml);
	}
	$("#"+div_id).find("#paging_first").click(function(){
		if($.isFunction(callback)){
			callback(1, {});
		}
	});
	$("#"+div_id).find("#paging_pre").click(function(){
		currentBlock--;
		currentPage = currentBlock*page_size-page_size+1;
		if(currentPage < 0) currentPage = 1;
		if($.isFunction(callback)){
			callback(currentPage,{});
		}
	});
	$("#"+div_id).find("#paging_next").click(function(){
		currentBlock++;
		currentPage = currentBlock*page_size-page_size+1;
		if(currentPage > totPage){
			currentPage = totPage;
		}
		if($.isFunction(callback)){
			callback(currentPage,{});
		}
	});
	$("#"+div_id).find("#paging_last").click(function(){
		if($.isFunction(callback)){
			callback(totPage,{});
		}
	});
	$("#"+div_id).find(".pag_num a").click(function(){
		currentPage = $(this).html();
		if($.isFunction(callback)){
			callback(currentPage,{});
		}
	});
	
	//combo box click 
	//페이징 수 선택 팝업div
	$('#pagingPopBtn a.btn_combo_down').unbind('click').bind('click', function(e) {
		$(this).parent().find("ul.up").fadeIn();
	});
	$('#pagingPopBtn').unbind('mouseleave').bind('mouseleave', function(e) {
		$(this).find("ul.up").fadeOut();
	});

	$("#pagingPopBtn ul li").unbind('click').bind("click", function() {
		
		$("#pagingPopBtn a.btn_combo_down").find("span").text($(this).find('a').text());
		$("#pagingPopBtn").find("ul.up").fadeOut();
		
		_searchList.setPagePerCnt($(this).find("a").text());
		_searchList.setPageNo(1);
		
		var currAct = location.href.substring(location.href.lastIndexOf("/")+1, location.href.lastIndexOf("."));
		localStorage.setItem(currAct + "_PAGE_PER_CNT", $(this).find("a").text());
		
		//drawTrcoList();
		callback(1,{});
	});
	
	//화살표 표시
	if(currentPage == 1){
		$("#paging_first").removeClass("on");
		$("#paging_pre").removeClass("on");
	}else{
		$("#paging_first").addClass("on")
		$("#paging_pre").addClass("on");
		$("#paging_next").addClass("on")
		$("#paging_last").addClass("on");
	}
	if(currentPage == totPage){
		$("#paging_next").removeClass("on");
	}
	if(currentPage == totPage){
		$("#paging_last").removeClass("on");
	}
	
}




function cf_submit(frm,url,m,t){
	if(url == undefined || url == null || url == ""){
		alert('URL 정보가 없습니다.');
		return;
	}
	var method = null2void(m,"post"),target = null2void(t,"_self");
	frm.method = null2void(method,'post');
	frm.target = null2void(target,'_self');
	frm.action = url;
	frm.submit();
}

