function fn_fileDownload(org_file_nm, save_file_nm, file_path){
    //var folder = file_path.replace($("#root").val(),"").replace(save_file_nm,"");
    var folder = file_path;
    $("#Form1").remove();
    var $form = $('<form id="Form1"></form>');
    $form.attr('action', 'serp_fileDownload.act');
    $form.attr('method', 'post');
    $form.appendTo('body');
    var fileName = $('<input type="hidden" name="fileName" value="'+save_file_nm+'">');
    var orgfilename = $('<input type="hidden" name="orgfilename" value="'+org_file_nm+'">');
    var folder = $('<input type="hidden" name="folder" value="'+folder+'">');
    $form.append(fileName).append(orgfilename).append(folder);
    $form.submit();
}

