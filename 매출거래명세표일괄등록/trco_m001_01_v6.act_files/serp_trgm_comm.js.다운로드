function sendPopup(elementList,sendGubn,bsnnNo,sessionData,taxCode){
	var checkList = $(elementList).find("input[type=checkbox]:checked");
	var call_url = "",url = "",totl_amt = 0,isValid = true;
	var dvsn_code = "",task_code = "",send_type = "";
	var connect_key = [],connect_info = [],req = {};
	var add_file_list = [];

	//elements 가 존재 하지는 확인
	if($(elementList).length  ==  0 ){
		alert('element 가 존재 하지 않습니다.');
		isValid = false;
		return false;
	}
	//전송 구분 확인
	if(sendGubn == "" || ( sendGubn != "fax" && sendGubn != "email")){
		alert('전송 구분값이 잘못 되었습니다.');
		isValid = false;
		return false;
	}
	// 사업자번호
	if(bsnnNo == ""){
		alert('사업자번호가 누락 되었습니다.');
		isValid = false;
		return false;
	}
	//session data
	if(!sessionData){
		alert('SESSION DATA가 누락 되었습니다.');
		isValid = false;
		return false;
	}
	//타입코드
	if(taxCode	 == ""){
		alert('타입 코드가 누락 되었습니다.');
		isValid = false;
		return false;
	}
	
	
	//체크된 항목
	if(checkList.length == 0) {
		alert("전송할 대상을 선택해 주세요.");
		isValid = false;
		return false;
	}
	
	//최개갯수 
	if(checkList.length > 5){
		alert("메일 및 팩스 전송은 최대 5개까지만 가능 합니다.");
		isValid = false;
		return false;
	}
	
	var strCompare = "";
	var strTrcoBsnnNo = "";
	var strTrcoBsnnNm = "";
	var strTrcoFaxNo = "";
	//동일 사업자번호 검증
	checkList.each(function(){		
		var trRow = $(this).closest('tr').prevAll().length; 
		var checkList =  _datList[trRow];
//		if ("" != strCompare && strCompare != checkList.BUYR_CORP_NO){
//			alert("사업자번호가 같은 건을 선택해 주세요.");
//			isValid = false;
//			return false;
//		}
//		strCompare = null2void(checkList.BUYR_CORP_NO,"");
		
		if ("" != strCompare && strCompare != checkList.TRCO_KEY){
			alert("같은 사업자의 자료를 선택해 주세요.");
			isValid = false;
			return false;
		}
		strCompare = null2void(checkList.TRCO_KEY,"");
		strTrcoBsnnNo = null2void(checkList.BUYR_CORP_NO,"");
		strTrcoBsnnNm = null2void(checkList.BUYR_CORP_NM,"");
		strTrcoFaxNo = null2void(checkList.BUYR_FAX,"");
		
		connect_key.push(checkList.TRANS_STAT_SEQ);
		totl_amt += parseInt(checkList.TOTL_AMT.replaceAll(',',''));
		var tmp = {
				"CONNECT_KEY" : checkList.TRANS_STAT_SEQ,
				"CONNECT_AMT" : checkList.TOTL_AMT,
				"REGS_DATE" : checkList.REGS_DATE.replace(/[^0-9]/gi,"")
		}
		connect_info.push(tmp);
		
		$.each(checkList.ADD_FILE_LIST, function(i,v) {
			var tmpfile = {
					"ADD_FILE_NAME" : v.FILE_ORIGN_NM,
					"ADD_FILE_PATH" : v.FILE_NM,
					"ADD_FILE_ORG_PATH" : v.FILE_PATH
			}
			add_file_list.push(tmpfile);
		});
	});
	
	var connect_rec = { "CONNECT_INFO" : connect_info};
	var add_file_info = { "ADD_FILE_LIST" : add_file_list};
	
	if(sendGubn == "fax" ){ url = "trco_fax_popup1.jsp";
	}else{ url = "trco_mail_popup1.jsp"; }
	
	if(taxCode == "16"){
		call_url  = "trgm_buyr_captur.jsp";
		dvsn_code = "S";
		task_code = "S001";
		send_type = "tran"; 
	}else{
		call_url  = "trgm_etc_capture.jsp";
		dvsn_code = "R";
		if(taxCode == "17"){ task_code = "R001"; send_type = "r001";}
		else if(taxCode == "18"){ task_code = "R002"; send_type = "r002";}
		else if(taxCode == "19"){ task_code = "R003"; send_type = "r003";}
		else{ task_code  = ""; send_type = "r001";}
	}

	req["TRCO_KEY"] 	= strCompare;
	req["TRCO_BSNN_NO"] = strTrcoBsnnNo.replace(/-/gi,"");
	req["DVSN_CODE"] 	= dvsn_code;
	req["TASK_CODE"] 	= task_code;
	req["TOTL_AMT"] 	= totl_amt;
	req["BUYR_CORP_NM"]	= strTrcoBsnnNm;//일시성거래처명 추가
	req["BUYR_CORP_FAX"]= strTrcoFaxNo;//일시성거래처 팩스번호 추가
	
	param = {"SESSION_DATA"	: sessionData,
			//"CONNECT_KEY" 	: connect_key,
			"CONNECT_REC" 	: encodeURIComponent(JSON.stringify(connect_rec)),
			"PRI_MY_IMG"	:"",
			"SEND_TYPE" 	:send_type,
			"CALL_URL"		: call_url,//"trgm_buyr_captur.jsp",
			"BSNN_NO"		: bsnnNo,
			"TRCO_INFO"		:encodeURIComponent(JSON.stringify(req)),
			"ADD_FILE_INFO"	:encodeURIComponent(JSON.stringify(add_file_info))
			
	}
	if(isValid){
		setFormToTaxbill(url, taxCode, param);
	}
}

