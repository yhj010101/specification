            $(".list_scroll_top").addClass("pdr");
            $(".list_scroll_top").find("colgroup").append("<col style=\"width:17px;\" nm=\"decoCol\">");
            $(".list_scroll_top").find("tr").append("<th scope=\"col\" nm=\"decoTh\"><div></div></th>");
        }else if ($(".list_scroll").hasScrollBar()){  // 세로 스크롤만 생겼을때
            $(".list_scroll_top").addClass("pdr");
            $(".list_scroll_top").find("col[nm='decoCol']").remove();
            $(".list_scroll_top").find("th[nm='decoTh']").remove();
        }else if(!$(".list_scroll").hasHorizontalScrollBar() && !$(".list_scroll").hasScrollBar()){ // 둘다 안생겼을때
            $(".list_scroll").attr("style", "height:509px;min-width:100%;overflow-y:auto;overflow-x:auto;");
            $(".list_scroll_top").removeClass("pdr");
            $(".list_scroll_top").find("col[nm='decoCol']").remove();
            $(".list_scroll_top").find("th[nm='decoTh']").remove();
        }
    };
    
