	cf_ifrmResize = function(obj, divname, width, height, style){
		
		
		var div_obj = $("#"+divname);
		
		if(width == null || width == "undefined" || width == "")
			width = obj.contentWindow.document.body.scrollWidth;

		if(height == null || height == "undefined" || height == "")
			height = obj.contentWindow.document.body.scrollHeight;

		var xpos = (document.body.offsetWidth/2 + document.documentElement.scrollLeft)-width/2; //
		var ypos = (document.body.offsetHeight/2 + document.documentElement.scrollTop)-height/2;	//
		
		obj.height = parseInt(height) +2;
		obj.width = parseInt(width) +2;
		
		// 레이어가 화면에 숨어서 처리
		if(ypos < 0){
			ypos = 0;
		}
		if(xpos < 0){
			xpos = 0;
		}

		if(divname == "trgm_item_srch") { // 품목 조회 팝업 가운데 정렬 2022-05-24
			div_obj.css("top", "-25.5px");
		} else {
			div_obj.css("top", ypos+"px");
		}
		div_obj.css("left", xpos+"px");
		$(div_obj).show();
		
	};

	function getByteLengthObj(input){
		var byteLength = 0;
		for (var inx = 0; inx < input.value.length; inx++) {
			var oneChar = escape(input.value.charAt(inx));
			if ( oneChar.length == 1 ) {
				byteLength ++;
			} else if (oneChar.indexOf("%u") != -1) {
				byteLength += 2;
			} else if (oneChar.indexOf("%") != -1) {
				byteLength += oneChar.length/3;
			}
		}
		return byteLength;
	}
	
	function moveNextFocus(elem, keycode){
		var IS_IE = false;
		if(navigator.appName == 'Microsoft Internet Explorer'){
			IS_IE = true;
		}
		//this 개체가 속한  폼이름 가져오기
		var thisFrm = elem.parentNode;
		while("form" != thisFrm.tagName.toString().toLowerCase()) 
		{
			thisFrm = eval(thisFrm.parentNode);	 
		}

		var nextFocus = elem;

		//다음 포커스 타겟 가져오기.
		for (var i = 0 ; i < thisFrm.elements.length ; i++)
		{
			//현재 this값이 선택된 elements이면 다음으로 이동될 포커스를 가져오기 위한 로직수행.
			if(elem == thisFrm.elements[i]) 
			{	   
				if(thisFrm.elements[i].nextfocus != undefined && thisFrm[thisFrm.elements[i].nextfocus] != undefined) {
					//nextfocus 속성이 있을경우 nextfocus값을 다음 포커스로 잡는다.
					nextFocus = thisFrm[thisFrm.elements[i].nextfocus];
					break;
				}

				//elements가 undefined 될때 까지 수행함.
				while(thisFrm.elements[++i] != undefined) 
				{   
					//현재 elements의 부모중의 속성이 display = none이면 다음 포커스 타겟을 가져온다.
					var targetCursor = eval(thisFrm.elements[i].parentNode);
					while("form" != targetCursor.tagName.toString().toLowerCase())  {
						if(targetCursor.parentNode.style.display == "none") break;
						targetCursor = eval(targetCursor.parentNode);   
					}
					if(targetCursor.parentNode.style.display == "none") continue;
					//elements타입이 input (text,radio,checkbox), textarea, select 일경우 다음 포커스 obj저장.
					if(thisFrm.elements[i].tagName.toString().toLowerCase() == "input" && 
						(thisFrm.elements[i].getAttribute("type") == "text" 
						 || thisFrm.elements[i].getAttribute("type") == "password" 
						 || thisFrm.elements[i].tagName.toString().toLowerCase() == "textarea"
						 || thisFrm.elements[i].tagName.toString().toLowerCase() == "select"
						) 
					)
					{

						var isReadonly = false;
						if(IS_IE){
							if(thisFrm.elements[i].getAttribute("readonly") != '' && thisFrm.elements[i].getAttribute("readonly") != null)
								isReadonly = true;
						}else{
							if(thisFrm.elements[i].getAttribute("readonly") != undefined)
								isReadonly = true;
						}

						// nextFocus 객체가 활성화 되지 않은 상태이면 다음 객체로....
						if(!(thisFrm.elements[i].disabled==true || isReadonly || thisFrm.elements[i].style.display == "none")){
							nextFocus = thisFrm.elements[i];
							break;
						}
					}
				}
			}
		}
		
		// 포커스 이동
		if(nextFocus != elem){
			if(nextFocus.tagName.toString().toLowerCase() == "select") {
				nextFocus.focus();
			}else {
				nextFocus.select();
			} 
		}
	}
	
	function fn_bsnnNoFormat(item, value){
		var tmpTrcoBsnnNo = item.TRCO_BSNN_NO.substring(0,3)+"-"+item.TRCO_BSNN_NO.substring(3,5)+"-"+item.TRCO_BSNN_NO.substring(5,10);
		var start_pos = item.TRCO_BSNN_NO.toUpperCase().indexOf(value.toUpperCase());
		var inputFormatVal = fn_inputFormat(start_pos, value);
		tmpTrcoBsnnNo = tmpTrcoBsnnNo.replace(inputFormatVal,"<strong style=\"color:#fe1a1a;\">" + inputFormatVal + "</strong>");
		
		return tmpTrcoBsnnNo;
	}
	
	//빨간색 표시해줄부분 포맷팅
	function fn_inputFormat(start_pos, value){
		var tmpInput = "";
		
		for(var i=start_pos; i<start_pos+value.length; i++){
			tmpInput += value.substr(i-start_pos,1);
			if(i==2 || i==4){
				tmpInput += "-";
			}
		}
		
		if(tmpInput.substring(tmpInput.length-1) == "-"){
			tmpInput = tmpInput.substring(0,tmpInput.length-1);
		}
		
		return tmpInput;
	}
