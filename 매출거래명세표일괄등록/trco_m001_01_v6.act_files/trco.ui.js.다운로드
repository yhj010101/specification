	trco.ui.fn_biznmAutocomplete = function(target,tmpTcmcRec, callbackFn){
		var xHtml = "";
		if($(target).parent().find(".ui-autocomplete-wrap").length == 0){
			xHtml += '<div class="ui-autocomplete-wrap">';
			xHtml += '<div id="APPEND_AUTO">';
			xHtml += '</div>';
			xHtml += '</div>';
			$(target).parent().append(xHtml);
		}

		$(target).autocomplete({
			appendTo : $(target).parent().find("#APPEND_AUTO"),
			minLength: 1,
			scroll: true,
			//source: tmpTcmcRec,
			source: function(request,response){
				
				var reqData = { 
					"USE_INTT_ID": $("input[name=USE_INTT_ID]").length>0?$("input[name=USE_INTT_ID]").val():"",
					"BSNN_NO": $("input[name=BSNN_NO]").length>0?$("input[name=BSNN_NO]").val():"",
					"TRCO_CMNM": request.term,
					"DATA_TYPE": "JSON"
				};
				$.ajax({
					url:"/tcmc/jsp/tcmc_0005_01_s4.jsp",
					type:'POST',
					data: reqData,
					async : true,
					dataType : 'json',
					success:function(data){
						data.TCMC_REC.push({"BUTTON":"Y"}); //20190717
						response(data.TCMC_REC);
					}
				});
			},
			focus: function(event, ui) {
				return false;
			},
			select: function(event, ui) {
				$(target).blur();
			
				if(ui.item.BUTTON){ //20190717
					trco_simple_append(); //거래처추가 팝업호출
					return false;
				}
				
				if( jQuery.isFunction( callbackFn ) ){
					callbackFn(event,ui.item);
					return false;
				}
				return false;
			}
		}).keyup(function(e){
			if($(e.target).val() == " ") $(e.target).val("");
			if($(e.target).val() == ""){
				$(e.target).attr("mapping","");
				return;
			}
			if (e.keyCode == 13){ return;}
		}).data('ui-autocomplete')._renderItem = function(ul, item) {

			if(item.BUTTON){ //20190717
				return $("<li></li>").data("ui-autocomplete-item",item).append('<a style="color:#3598db;">[거래처추가]</a>').appendTo(ul);
			}
			//if(item.TRCO_BSNN_NO.length != 10) item.TRCO_BSNN_NO = "";
			
			var value = $(target).val();
			var tmpLabel = item.label;
			var start_pos = item.label.toUpperCase().indexOf(value.toUpperCase());
			if(start_pos > -1){
				tmpLabel = item.label.substring(0, start_pos);
				tmpLabel += "<strong style=\"color:#fe1a1a;\">" + item.label.substring(start_pos, start_pos + value.length) + "</strong>";
				tmpLabel += item.label.substring(start_pos + value.length);
			}
			
			return $("<li></li>").data("ui-autocomplete-item",item).append(
					"<div class=\"combo_postAdd_item\" >"
					+ "<span class=\"tx_name\">" 
//					+ item.label.replace($(target).val(),"<strong style=\"color:#fe1a1a;\">" + $(target).val() + "</strong>")
					+ tmpLabel
					+"("+item.TRCO_RPPR_NM+")"
					+"</span>"
//					+"<span class=\"tx_no\">" + item.TRCO_BSNN_NO + "</span>"
					+"<span class=\"tx_no\">" + item.TRCO_BSNN_NO.replace($(target).val(),"<strong style=\"color:#fe1a1a;\">" + $(target).val() + "</strong>") + "</span>"
					+ "</div>").appendTo(ul);
		};
	}

