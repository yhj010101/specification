function null2void(_instance , custom_value){
	var instance = _instance;
	if( custom_value == null ) custom_value = "";
	if( instance == "undefined" || instance == null || instance == "null" || instance == "" ){
		return custom_value;
	}
	return instance;
}
function null2zero(str) {
    if(str == null) str = '0';
    if(str == "") str = '0';
    if(isNaN(str.toString().replace(/,/g, ""))) str = '0';
    return str;
}

// 컴포넌트 포커스 맞추기
function focusCampo(_this){
    if(navigator.userAgent.indexOf("Chrome") != -1 ){
        if (_this.val().length != 0 ){
            var temp =_this.val();
            _this.val('');
            _this.val(temp);
            _this.focus();
        }else{
            _this.focus();
        }
    }
    else if((navigator.userAgent.indexOf("MSIE") != -1 ) || (!!document.documentMode == true )) //IF IE > 10
    {
        var value =  _this.val(); //store the value of the element
        var message = "";
        if (value != "") {
            message = value ;
        };
        _this.focus().val(message);
        _this.unbind();
    }
}

