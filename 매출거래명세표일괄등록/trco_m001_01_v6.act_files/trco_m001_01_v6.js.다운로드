/**
 * 스크롤 마지막 이벤트 등록
 */
$.fn.endOfScroll = function(callback) {
	return this.each(function() {
		if (!callback) {
			$(this).off("scroll");
		} else {
			$(this).on("scroll", function() {
				if (Math.ceil($(this).scrollTop() + $(this).innerHeight()) >= $(this)[0].scrollHeight) {
					if ($.isFunction(callback)) {
						callback.call($(this));
					}
				}
			});
		}
	});
};

