//건별이체화면으로 이동(cs)
function moveTrans(bank_cd, acct_no, owac_nm, bzaq_no, bzaq_nm, wdrw_bank_cd, wdrw_acct_no, rslt_cd){
	if('WEB' == _ACS_DVC && $('#WEB_KYUNGRI').val() != "Y") {
		return;
	}
	
	if (rslt_cd != "0000" && rslt_cd != "") {
		if(confirm("선택하신 계좌번호는 예금주명이 확인되지 않은 계좌입니다.\n그래도 진행하시겠습니까?")) {
			moveTrans(bank_cd, acct_no, owac_nm, bzaq_no, bzaq_nm, wdrw_bank_cd, wdrw_acct_no, "0000");
		}
	} else {
		var result = {RSLT_CD:"0000"};
		
		if(result.RSLT_CD=="0000"){
			var reqData = {};
			var reqDatas   = [];
			var input      = {};
			reqData.APP_ID     = "";
			reqData.MENU_ID    = "m5230";
			reqData.MENU_TITLE = "건별이체";
			var rec = [];
			rec.push({"RCV_BANK_CD":bank_cd, "RCV_ACCT_NO":acct_no, "RCV_OWAC_NM":owac_nm, "BZAQ_NO":bzaq_no, "BZAQ_NM":bzaq_nm }); //입금계좌
			if ($('#WEB_KYUNGRI').val() == "Y") {
				reqData.MENU_PARAM = {"REC":rec , "BANK_CD":wdrw_bank_cd, "ACCT_NO":wdrw_acct_no, "TYPE":"T"}; 
			} else {
				reqData.MENU_PARAM = {"REC":rec , "BANK_CD":wdrw_bank_cd, "ACCT_NO":wdrw_acct_no}; 
			}
			reqDatas.push(reqData);
			
			input.TRAN_NO  = "SERP30_SVC_P010";
			input.USER_ID  = _USER_ID;
			input.DATETIME = moment().format('YYYYMMDDHHmmSS');
			input.REQ_DATA = reqDatas;
			
			var JSonInp = JSON.stringify(input);
			if( typeof(window.external) != "undefined" ) {
				var result;
				try{
					result = window.external.RequestEmWebApi(JSonInp);
					result = JSON.parse(result);
				}catch(e) {
					result = {RSLT_CD:"9999",RSLT_MSG:e};
				}
				if(result.RSLT_CD != "0000") {
					alert(result.RSLT_MSG+"("+result.RSLT_CD+")");
				}
			}
		} else {
			alert(result.RSLT_MSG+"("+result.RSLT_CD+")");
		}
	}
}

