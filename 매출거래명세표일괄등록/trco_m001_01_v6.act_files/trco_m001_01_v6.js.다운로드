        var jexAjax = jex.createAjaxUtil("trco_0005_06_u001");
        jexAjax.set("GRP_CD", groupCode);
        jexAjax.set("GRP_ICON", "6_1");
        jexAjax.set("GRP_NM", newGroupName);
        jexAjax.execute(function (dat) {
            common.app.success("수정되었습니다.");
            webCrudUserGrpList(jexjs.null2Void(selectedGrpTypes));
            clearEditingState();
            $('.n_btn.cancel, .n_btn.save').hide();
            $('.n_btn.plus').show();
        });
    }

    function webCrudUserGrpList(types) {
        var jexAjax = jex.createAjaxUtil("trco_0005_02_l001");
        jexAjax.execute(function (dat) {
            appendBodyForView(dat, types);
            appendBodyForEdit(dat);
            appendBodyForUpdate(dat, types);
        });
    }

    function appendBodyForUpdate(dat, types) {
        var html = `
            <li><a href="javascript:void(0);" class="update-toggle toggle-button ${types == "S" ? 'active' : 'default'}" data-type="S" val-grpcd="S"><span>매출</span></a></li>
            <li><a href="javascript:void(0);" class="update-toggle toggle-button ${types == "B" ? 'active' : 'default'}" data-type="B" val-grpcd="B"><span>매입</span></a></li>
            <li><a href="javascript:void(0);" class="update-toggle toggle-button ${types == "E" ? 'active' : 'default'}" data-type="E" val-grpcd="E"><span>기타</span></a></li>
        `;
        if (dat?.GRP_LIST?.length) {
            for (const grp of dat.GRP_LIST) {
                html += `
                    <li>
                        <a href="javascript:void(0);" class="update-toggle toggle-button ${types == grp.GRP_CD ? 'active' : 'default'}" data-type="${grp.GRP_CD}" val-grpcd="${grp.GRP_CD}">
                            <span>${grp.GRP_NM}</span>
                        </a>
                    </li>
                `;
            }
        }
        $('#group_layer #updateGrp .chk_js_list').empty().append(html);
    }

    function appendBodyForView(dat, types) {
        var selectedList = types ? types.split(",") : [];
        var html = `
            <li>
                <a href="javascript:void(0);" class="${selectedList.length === 0 ? 'on' : ''}">
                    <strong>전체</strong>
                </a>
            </li>
            <li>
                <a href="javascript:void(0);" class="filter-toggle toggle-button ${selectedList.includes("S") ? 'active' : 'default'}" data-type="S" val-grpcd="S"><span>매출</span></a>
            </li>
            <li>
                <a href="javascript:void(0);" class="filter-toggle toggle-button ${selectedList.includes("B") ? 'active' : 'default'}" data-type="B" val-grpcd="B"><span>매입</span></a>
            </li>
            <li>
                <a href="javascript:void(0);" class="filter-toggle toggle-button ${selectedList.includes("E") ? 'active' : 'default'}" data-type="E" val-grpcd="E"><span>기타</span></a>
            </li>
        `;
        if (dat?.GRP_LIST?.length) {
            for (const grp of dat.GRP_LIST) {
                html += `
                    <li>
                        <a href="javascript:void(0);" class="filter-toggle toggle-button ${selectedList.includes(grp.GRP_CD) ? 'active' : 'default'}" data-type="${grp.GRP_CD}" val-grpcd="${grp.GRP_CD}">
                            <span>${grp.GRP_NM}</span>
                        </a>
                    </li>
                `;
            }
        }
        $('#group_layer #filterGrp .chk_js_list').empty().append(html);
    }

    function appendBodyForEdit(dat) {
        var html = `
            <p><span class="gpNm dim" title="매출">매출</span></p>
            <p><span class="gpNm dim" title="매입">매입</span></p>
            <p><span class="gpNm dim" title="기타">기타</span></p>
        `;
        if (Array.isArray(dat?.GRP_LIST)) {
            html += dat.GRP_LIST.map(grp => `
                <p>
                    <span class="gpNm" data-type="${grp.GRP_CD}" val-grpcd="${grp.GRP_CD}" title="${grp.GRP_NM}">${grp.GRP_NM}</span>
                    <span class="util_bt">
                        <a href="#" class="mod_bt">수정</a>
                        <a href="#" class="del_bt">삭제</a>
                    </span>
                </p>
            `).join('');
        }
        $('#editGrp').html(html);
    }
	
	function sf_webDrawGrpCheckAll() {
	    $(".chk_js_list.all_chk_update_type li").each(function () {
	        sf_webDrawGrpCheck(this);
	    });
	}

	function sf_webDrawGrpCheck(objGrp) {
	    var grp_cd = "," + $(objGrp).find("a").attr("val-grpcd") + ",";
	    var grpChkCnt = 0;
	    $("input[class=chk]:checked").each(function () {
	        var grp_cd_list = "," + $(this).parent().parent().find("input[name=GRP_CD]").val() + ",";
	        if (grp_cd_list.indexOf(grp_cd) > -1) {
	            grpChkCnt++;
	        }
	    });

	    if (grpChkCnt === 0) {
	        $(objGrp).find("a").removeClass('active minus').addClass('default');
	        $(objGrp).find("a").attr("val-checkstatus", "3");
	    } else if (grpChkCnt === $("input[class=chk]:checked").length) {
	        $(objGrp).find("a").removeClass('default').addClass('active');
	        $(objGrp).find("a").attr("val-checkstatus", "1");
	    } else {
	        $(objGrp).find("a").removeClass('default').addClass('minus');
	        $(objGrp).find("a").attr("val-checkstatus", "2");
	    }
	}
	
	// 전체 / 개별 그룹 선택
	$(document).on('click', '.chk_js_list.all_chk_type a', function () {
	    var $clicked = $(this);
	    var isAll = $clicked.find('strong').length > 0;
	    var inqyType = "";
		var grpCdLenght = $('.chk_js_list.all_chk_type li a').length - 1
		selectedGrpTypesDisplay = []
	    if (isAll) {
	        $('.chk_js_list .toggle-button').removeClass('active').addClass('default');
	        $('.chk_js_list a').removeClass('on disabled');
	        $clicked.addClass('on');
	        selectedGrpTypes = '';
	        inqyType = "1";
			
			selectedGrpTypesDisplay = []
	    } else {
	        $clicked.toggleClass('active default');
			$('.chk_js_list a').first().addClass('on disabled');

	        var types = [];
	        $('.chk_js_list .filter-toggle.active').each(function () {
	            types.push($(this).attr('data-type'));
				selectedGrpTypesDisplay.push($(this).text());
	        });
	        selectedGrpTypes = types.join(',');
	        inqyType = "2";
			
			if (types.length === 0 || types.length === grpCdLenght) {
				$('.chk_js_list.all_chk_type li a.filter-toggle').removeClass('active').addClass('default');
		    	$('.chk_js_list.all_chk_type li a').first().removeClass('on disabled').addClass('on');
				inqyType = "1";
		    }
	    }
		
		var count = selectedGrpTypesDisplay.length;
		var first = selectedGrpTypesDisplay[0] || "전체";

		var text =
		  count > 1 ? `${first} 외 ${count - 1}` :
		  count === 1 ? `${first}` :
		  `전체 그룹`;

		$("#grpPopupBtn").text(text);

	    _searchList.setInqyDsnc(inqyType);
	    _searchList.setGrpCd(selectedGrpTypes);
	    drawTrcoList();
	});

