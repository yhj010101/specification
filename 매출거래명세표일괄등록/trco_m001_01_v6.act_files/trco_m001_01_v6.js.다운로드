function updateTrcoGrp(){
	
	//그룹으로 지정할 거래처를 선택하세요.
	if($("input[class=chk]:checked").length == 0){
		alert("거래처 그룹 지정하기는 선택된 거래처에 관리 그룹을 설정합니다.\n\n거래처 선택 후 다시 진행해주시기 바랍니다.");
		return true;
	}
	
	var isUpdate = true;
	if(isUpdate == false){
		return;
	}
	
	var sendGrpTrcoList = [];
	
	// 경리나라 6.1
	//거래처목록 (체크 목록 가져오기)
	$("input[class=chk]:checked").each(function(){
		var _this = this;
		var trcoRec = _datTrcoList[$("input[class=chk]").index(_this)];
		console.log("trcoRec: ", trcoRec);

		//기본그룹,사용자그룹 목록에서 체크
		$(".chk_js_list.all_chk_update_type li").each(function(){
			var updateStatus = "";
			var grp_cd = "," + $(this).find("a").attr("val-grpcd") + ",";
			
			//grp_cd_list value of row GRP 
			var grp_cd_list = ","+ $(_this).parent().parent().find("input[name=GRP_CD]").val() + ",";

			//기존에 그룹으로 지정되어 있었으면 등록과정 건너뛰기
			if(grp_cd_list.indexOf(grp_cd) > -1 && $(this).find("a").hasClass('active')){
				return true;
			}
			
			//기존에 그룹으로 없었으면 삭제과정 건너뛰기
			if(grp_cd_list.indexOf(grp_cd) == -1 && $(this).find("a").hasClass('default')){
				return true;
			}
			
			
			if( $(this).find("a").hasClass('active')){//그룹에 거래처 등록
				updateStatus = "I";
			}else if( $(this).find("a").hasClass('default')){ //그룹에서 거래처 삭제
				updateStatus = "D";
			}else{ //기존과 그룹이 동일하다면 건너뛰기
				return true;
			}

			sendGrpTrcoList.push({
				"BSNN_NO":trcoRec.TRCO_BSNN_NO.replace(/-/gi,""), 
				"USER_ID":"",
				"GRP_CD":$(this).find("a").attr("val-grpcd"),
				"TRCO_KEY":trcoRec.TRCO_KEY,
				"GRP_DSNC":updateStatus
			});
		});
	});

	var jexAjax = jex.createAjaxUtil("trco_0005_09_u001");

	jexAjax.set("GRP_LIST", sendGrpTrcoList);

	jexAjax.execute(function(dat) {
		common.app.success("저장되었습니다.");
		/*malert("WM0002");*///등록완료

		$(".ly_group_slbx").fadeOut();
		// 경리나라 6.1
		$("#grpList .filter_tit").html("거래처 그룹 지정하기 <a href=\"#none\" class=\"btn_popset\" style=\"display:block;top:8px;right:7px;\"><img src=\"../img/serp/ico/icon_btnset_off.png\" alt=\"그룹설정\"></a>");
		
		if(sendGrpTrcoList.length > 0){
			drawTrcoList();				//거래처 목록 표시
			//drawBscGrpList();			//기본그룹 목록 표시
			drawUserGrpList();			//사용자그룹 목록 표시
		}
		
		$('.title_opt_chkv').hide();
		$('input#chk_all, input.chk').prop('checked', false);
		$('.h1_title_wrap.top_content').css('visibility', 'visible');
	});
