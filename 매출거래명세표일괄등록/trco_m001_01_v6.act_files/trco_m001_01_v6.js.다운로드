function fileExce(file){
	var res = "";
	if(file.toLowerCase().indexOf("pdf") > -1){
		res = ".pdf";
	}else if(file.toLowerCase().indexOf("excel") > -1){
		res = ".xlsx";
	}else if(file.toLowerCase().indexOf("ppt") > -1){
		res = ".pptx";
	}else if(file.toLowerCase().indexOf("word") > -1){
		res = ".docx";
	}else if(file.toLowerCase().indexOf("hwp") > -1){
		res = ".hwp";
	}
	return res;
}

